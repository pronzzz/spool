{
  "name": "spool",
  "version": "2.0.0",
  "description": "Wind whole YouTube playlists onto your disk. A calm web interface and a tiny local engine for yt-dlp.",
  "type": "module",
  "license": "MIT",
  "author": "Pranav Dwivedi",
  "homepage": "https://getspool.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pronzzz/spool.git"
  },
  "bin": {
    "spool": "engine/cli.js"
  },
  "files": [
    "engine/*.js",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "engine": "node engine/cli.js --no-open",
    "build": "tsc -p web && vite build && node scripts/pack.js",
    "preview": "vite preview",
    "test": "node --test engine/test/*.test.js",
    "assets": "node scripts/assets.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "preact": "^10.29.8",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
