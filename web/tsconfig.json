{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    "paths": {
      "react": [
        "../node_modules/preact/compat/"
      ],
      "react-dom": [
        "../node_modules/preact/compat/"
      ],
      "react-dom/client": [
        "../node_modules/preact/compat/client"
      ],
      "react/jsx-runtime": [
        "../node_modules/preact/jsx-runtime"
      ]
    },
    "jsxImportSource": "preact"
  },
  "include": [
    "src"
  ]
}